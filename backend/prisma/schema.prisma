// Generado por Antigravity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoPlan {
  BORRADOR
  ACTIVO
  CERRADO
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoActividad {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CON_ALERTA
  VENCIDA
}

enum RolUsuario {
  ADMIN
  GESTOR
  OBSERVADOR
}

enum EstadoLocalidad {
  NO_INICIADA
  EN_CURSO_SIN_VALIDAR
  COMPLETA_SIN_VALIDAR
}

enum EstadoValidacion {
  PENDIENTE_REVISION
  VALIDADA_COMPLETADA
  VALIDADA_EN_CURSO
  VALIDADA_SIN_AVANCE
}

enum NivelAlerta {
  CRITICA
  MODERADA
  INFORMATIVA
}

enum TipoAlerta {
  VENCIMIENTO
  SIN_EVIDENCIA
  BAJO_AVANCE
  RIESGO_EXTERNO
}

model Usuario {
  id        String     @id @default(uuid())
  email     String     @unique
  nombre    String
  rol       RolUsuario @default(OBSERVADOR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  asignaciones     AsignacionLocalidad[]
  comentarios      Comentario[]
  evidencias       Evidencia[]
  localidades      Localidad[] // si es responsable principal
  alertasResueltas Alerta[]              @relation("ResueltaPor")
  fichasAlertas          FichaAlerta[]
  fichasResultados       FichaResultados[]
  reuniones              Reunion[]
  informes               Informe[]
  eventos                Evento[]
  seguimientosNormativos SeguimientoNormativo[]
  otrosEspacios          OtroEspacioArticulacion[]

  // Ficha Resultados - Tracking por sección
  fichasEjecucionAct     FichaResultados[] @relation("EjecucionAct")
  fichasObrasAct         FichaResultados[] @relation("ObrasAct")
  fichasComitesAct       FichaResultados[] @relation("ComitesAct")
  fichasResiduosAct      FichaResultados[] @relation("ResiduosAct")
  fichasVentaAct         FichaResultados[] @relation("VentaAct")
  fichasConvivenciaAct   FichaResultados[] @relation("ConvivenciaAct")
  fichasActuacionesAct   FichaResultados[] @relation("ActuacionesAct")
  fichasEstrategiasAct   FichaResultados[] @relation("EstrategiasAct")
  fichasRollosAct        FichaResultados[] @relation("RollosAct")
}

model Plan {
  id            String     @id @default(uuid())
  nombre        String
  ano           Int
  descripcion   String?
  estado        EstadoPlan @default(BORRADOR)
  fechaCreacion DateTime   @default(now())
  creadoPor     String

  objetivos ObjetivoEstrategico[]
}

model ObjetivoEstrategico {
  id          String  @id @default(uuid())
  planId      String
  codigo      String // ej: "O1"
  nombre      String
  descripcion String?
  orden       Int

  plan                 Plan                 @relation(fields: [planId], references: [id])
  programas            Programa[]
  reportesCualitativos ReporteCualitativo[]
  fichasAlertas        FichaAlerta[]
}

model Programa {
  id          String  @id @default(uuid())
  objetivoId  String
  codigo      String // ej: "P03"
  nombre      String
  descripcion String?

  objetivo ObjetivoEstrategico @relation(fields: [objetivoId], references: [id])
  hitos    Hito[]
}

model Hito {
  id          String   @id @default(uuid())
  programaId  String
  codigo      String // ej: "H2"
  nombre      String
  descripcion String?
  fechaLimite DateTime

  programa    Programa    @relation(fields: [programaId], references: [id])
  actividades Actividad[]
}

model Actividad {
  id                       String          @id @default(uuid())
  hitoId                   String
  codigoCompleto           String          @unique // ej: "P03.H2.A1"
  nombre                   String
  descripcion              String?
  fechaInicio              DateTime?
  fechaLimite              DateTime?
  prioridad                Prioridad       @default(MEDIA)
  tiposEvidenciaRequeridos String[] // Array de strings o JSON
  indicadorMeta            Float
  indicadorUnidad          String
  estado                   EstadoActividad @default(PENDIENTE)
  creadoPor                String
  fechaCreacion            DateTime        @default(now())
  ultimaModificacion       DateTime        @updatedAt

  hito         Hito                  @relation(fields: [hitoId], references: [id])
  asignaciones AsignacionLocalidad[]
  subTareas    SubTarea[]
  evidencias   Evidencia[]
  comentarios  Comentario[]
  alertas      Alerta[]
  FichaAlerta  FichaAlerta[]
}

model Localidad {
  id                     String  @id @default(uuid())
  nombre                 String
  codigoDANE             String?
  responsablePrincipalId String?
  colorHex               String?

  responsablePrincipal Usuario?              @relation(fields: [responsablePrincipalId], references: [id])
  asignaciones         AsignacionLocalidad[]
  evidencias           Evidencia[]
  comentarios          Comentario[]
  alertas              Alerta[]
  FichaAlerta          FichaAlerta[]
}

model AsignacionLocalidad {
  id               String           @id @default(uuid())
  actividadId      String
  localidadId      String
  responsableId    String?
  fechaAsignacion  DateTime         @default(now())
  observaciones    String?
  estadoLocal      EstadoLocalidad  @default(NO_INICIADA)
  estadoValidacion EstadoValidacion @default(PENDIENTE_REVISION)
  porcentajeAvance Float            @default(0)

  actividad   Actividad @relation(fields: [actividadId], references: [id])
  localidad   Localidad @relation(fields: [localidadId], references: [id])
  responsable Usuario?  @relation(fields: [responsableId], references: [id])

  @@unique([actividadId, localidadId])
}

model SubTarea {
  id                 String  @id @default(uuid())
  actividadId        String
  descripcion        String
  completada         Boolean @default(false)
  ordenVisualizacion Int     @default(0)

  actividad Actividad @relation(fields: [actividadId], references: [id])
}

model Evidencia {
  id                 String    @id @default(uuid())
  actividadId        String
  localidadId        String
  subidoPorId        String
  tipoEvidencia      String // documento/foto/video/enlace/reporte
  nombreArchivo      String
  urlArchivo         String // Ruta local o S3
  descripcion        String?
  fechaSubida        DateTime  @default(now())
  comentarioAdjunto  String?
  verificadaPorAdmin Boolean   @default(false)
  fechaVerificacion  DateTime?

  actividad Actividad @relation(fields: [actividadId], references: [id])
  localidad Localidad @relation(fields: [localidadId], references: [id])
  subidoPor Usuario   @relation(fields: [subidoPorId], references: [id])
}

model Comentario {
  id            String   @id @default(uuid())
  actividadId   String
  localidadId   String
  autorId       String
  texto         String
  fechaCreacion DateTime @default(now())
  esAlerta      Boolean  @default(false)
  tipoAlerta    String?

  actividad Actividad @relation(fields: [actividadId], references: [id])
  localidad Localidad @relation(fields: [localidadId], references: [id])
  autor     Usuario   @relation(fields: [autorId], references: [id])
}

model Alerta {
  id              String      @id @default(uuid())
  actividadId     String
  localidadId     String
  tipo            TipoAlerta
  descripcion     String
  nivel           NivelAlerta
  activa          Boolean     @default(true)
  fechaCreacion   DateTime    @default(now())
  resueltaPorId   String?
  fechaResolucion DateTime?

  actividad   Actividad @relation(fields: [actividadId], references: [id])
  localidad   Localidad @relation(fields: [localidadId], references: [id])
  resueltaPor Usuario?  @relation("ResueltaPor", fields: [resueltaPorId], references: [id])
}

model CorteMensual {
  id          String               @id @default(uuid())
  nombre      String
  fechaLimite DateTime
  esActivo    Boolean              @default(false)
  reportes    ReporteCualitativo[]
}

model ReporteCualitativo {
  id                     String  @id @default(uuid())
  objetivoId             String
  corteId                String
  principalesAvances     String? @db.Text
  alertasRecomendaciones String? @db.Text

  objetivo ObjetivoEstrategico @relation(fields: [objetivoId], references: [id])
  corte    CorteMensual        @relation(fields: [corteId], references: [id])

  @@unique([objetivoId, corteId])
}

model FichaAlerta {
  id              String    @id @default(uuid())
  objetivoId      String?
  actividadId     String?
  localidadId     String?
  tipo            String // BLOQUEO_GESTION, BLOQUEO_GABINETE, BLOQUEO_ALTO_NIVEL, ESTRUCTURAL
  descripcion     String
  responsable     String
  fechaCompromiso DateTime?
  estado          String    @default("ABIERTA") // ABIERTA, RESUELTA
  ultimaAccion    String?   @db.Text
  creadoPorId     String
  fechaCreacion   DateTime  @default(now())

  objetivo  ObjetivoEstrategico? @relation(fields: [objetivoId], references: [id])
  actividad Actividad?           @relation(fields: [actividadId], references: [id])
  localidad Localidad?           @relation(fields: [localidadId], references: [id])
  creador   Usuario              @relation(fields: [creadoPorId], references: [id])
}

// ─── MÓDULO GESTIÓN Y RESULTADOS ─────────────────────────────────────────────

model FichaResultados {
  id                       String   @id @default(uuid())
  periodo                  DateTime @unique // fecha de corte del reporte
  // Ejecución presupuestal
  compromisosPct           Float?
  girosPct                 Float?
  procesosMonitoreados     Int?
  procesosRequierenComite  Int?
  alertaEjecucion          String?  @db.Text
  // Obras locales
  metaObras                Int?
  intervencionesFinalizadas Int?
  kmCarrilIntervenido      Float?
  kmIntervenidos           Float?
  alertaObras              String?  @db.Text
  // Comités de contratación
  comitesRealizados        Int?
  comitesMeta              Int?
  alertaComites            String?  @db.Text
  // Espacio público – Residuos (general)
  accionesReportadas       Int?
  residuosM3               Float?
  espacioPublicoM2         Float?
  // Espacio público – Venta Informal / Parqueo
  puntosIntervenidos       Int?
  ventaInformal            Int?
  orgParqueo               Int?
  m2RecuperadosInformal    Float?
  personasReubicadas       Int?
  // Convivencia y seguridad
  motosContratadas         Int?
  motosPendientesFdl       Int?
  motosAlmacenFdl          Int?
  motosEntregadas          Int?
  alertaConvivencia        String?  @db.Text
  // Actuaciones
  archivosPct              Float?
  metaArchivos             Int?
  fallosPrimeraEstanciaPct Float?
  metaFallos               Int?
  // Estrategias de memoria
  estrategiasResueltas     Int?
  estrategiasFormulacion   Int?
  // Rollos legendarios
  rollosResueltos          Int?
  rollosEnCurso            Int?
  alertaRollos             String?  @db.Text
  // General
  observaciones            String?  @db.Text
  reportadoPorId           String
  fechaCreacion            DateTime @default(now())

  // Alertas faltantes
  alertaEspacioResiduos    String?  @db.Text
  alertaEspacioVenta       String?  @db.Text
  alertaActuaciones        String?  @db.Text
  alertaEstrategias        String?  @db.Text

  // Tracking por sección
  ejecucionActPorId         String?
  ejecucionActEn            DateTime?
  obrasActPorId             String?
  obrasActEn                DateTime?
  comitesActPorId           String?
  comitesActEn              DateTime?
  espacioResiduosActPorId   String?
  espacioResiduosActEn      DateTime?
  espacioVentaActPorId      String?
  espacioVentaActEn         DateTime?
  convivenciaActPorId       String?
  convivenciaActEn          DateTime?
  actuacionesActPorId       String?
  actuacionesActEn          DateTime?
  estrategiasActPorId       String?
  estrategiasActEn          DateTime?
  rollosActPorId            String?
  rollosActEn               DateTime?

  reportadoPor          Usuario @relation(fields: [reportadoPorId], references: [id])
  ejecucionActPor       Usuario? @relation("EjecucionAct", fields: [ejecucionActPorId], references: [id])
  obrasActPor           Usuario? @relation("ObrasAct", fields: [obrasActPorId], references: [id])
  comitesActPor         Usuario? @relation("ComitesAct", fields: [comitesActPorId], references: [id])
  espacioResiduosActPor Usuario? @relation("ResiduosAct", fields: [espacioResiduosActPorId], references: [id])
  espacioVentaActPor    Usuario? @relation("VentaAct", fields: [espacioVentaActPorId], references: [id])
  convivenciaActPor     Usuario? @relation("ConvivenciaAct", fields: [convivenciaActPorId], references: [id])
  actuacionesActPor     Usuario? @relation("ActuacionesAct", fields: [actuacionesActPorId], references: [id])
  estrategiasActPor     Usuario? @relation("EstrategiasAct", fields: [estrategiasActPorId], references: [id])
  rollosActPor          Usuario? @relation("RollosAct", fields: [rollosActPorId], references: [id])
}

model Reunion {
  id               String   @id @default(uuid())
  // SESION_UNIDAD | REUNION_SEGUIMIENTO_AL | STOCKTAKE | VISITA_LOCALIDAD | MESA_TRABAJO | OTRA
  tipoReunion      String
  // ALCALDIA | SECTOR_GOBIERNO | ENTIDAD_DISTRITO | INTERNA | OTRA_ENTIDAD
  tipoContraparte  String
  // GLOBAL | P01..P10 | OTRO
  tematica         String   @default("GLOBAL")
  subtematica      String?
  objeto           String
  fecha            DateTime
  horaInicio       String
  horaFin          String
  lugar            String
  // PRESENCIAL | VIRTUAL | TELEFONICA | MIXTA
  modalidad        String
  responsable      String
  desarrollo       String   @db.Text
  imagenAsistencia String?  // URL en Supabase Storage
  creadoPorId      String
  fechaCreacion    DateTime @default(now())

  creadoPor   Usuario            @relation(fields: [creadoPorId], references: [id])
  asistentes  AsistenteReunion[]
  compromisos CompromisoReunion[]
}

model AsistenteReunion {
  id        String  @id @default(uuid())
  reunionId String
  nombre    String
  cargo     String?
  entidad   String?

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
}

model CompromisoReunion {
  id           String    @id @default(uuid())
  reunionId    String
  descripcion  String
  responsable  String
  fechaEntrega DateTime?
  cumplido     Boolean   @default(false)

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
}

model Informe {
  id            String   @id @default(uuid())
  // BOLETIN_TRANSFORMACION | REPORTE_SDG | INFORME_OAP | OTRO
  tipo          String
  titulo        String
  periodo       String
  descripcion   String?  @db.Text
  urlArchivo    String?
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}

model Evento {
  id            String   @id @default(uuid())
  // CONECTAR_TRANSFORMAR | OTRO
  tipo          String
  nombre        String
  fecha         DateTime
  lugar         String
  descripcion   String?  @db.Text
  resultados    String?  @db.Text
  urlArchivo    String?
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}

model SeguimientoNormativo {
  id            String   @id @default(uuid())
  // DECRETO | PROYECTO_LEY | OTRO
  tipo          String
  nombre        String
  descripcion   String?  @db.Text
  // EN_FORMULACION | EXPEDIDO | EN_IMPLEMENTACION | ARCHIVADO
  estado        String   @default("EN_FORMULACION")
  avances       String?  @db.Text
  urlDocumento  String?
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}

model OtroEspacioArticulacion {
  id            String   @id @default(uuid())
  // CIRCULO_CALIDAD | COMITE_OBRAS | COMITE_ESPACIO_PUBLICO | COMITE_RESIDUOS | COMITE_ACTUACIONES | OTRO
  tipo          String
  nombre        String
  fecha         DateTime
  descripcion   String?  @db.Text
  resultados    String?  @db.Text
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}
