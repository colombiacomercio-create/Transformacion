// Generado por Antigravity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoPlan {
  BORRADOR
  ACTIVO
  CERRADO
}

enum Prioridad {
  ALTA
  MEDIA
  BAJA
}

enum EstadoActividad {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CON_ALERTA
  VENCIDA
}

enum RolUsuario {
  ADMIN
  GESTOR
  OBSERVADOR
}

enum EstadoLocalidad {
  NO_INICIADA
  EN_CURSO_SIN_VALIDAR
  COMPLETA_SIN_VALIDAR
}

enum EstadoValidacion {
  PENDIENTE_REVISION
  VALIDADA_COMPLETADA
  VALIDADA_EN_CURSO
  VALIDADA_SIN_AVANCE
}

enum EstadoRevisionDraft {
  SIN_BORRADOR
  BORRADOR_GENERADO
  EN_REVISION
  APROBADO_PUBLICADO
}

enum CalidadPrechequeo {
  APTO
  DUDOSO
  NO_APTO
}

enum NivelAlerta {
  CRITICA
  MODERADA
  INFORMATIVA
}

enum TipoAlerta {
  VENCIMIENTO
  SIN_EVIDENCIA
  BAJO_AVANCE
  RIESGO_EXTERNO
}

model Usuario {
  id        String     @id @default(uuid())
  email     String     @unique
  nombre    String
  rol       RolUsuario @default(OBSERVADOR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  asignaciones     AsignacionLocalidad[]
  comentarios      Comentario[]
  evidencias       Evidencia[]
  localidades      Localidad[] // si es responsable principal
  alertasResueltas Alerta[]              @relation("ResueltaPor")
  fichasAlertas          FichaAlerta[]
  fichasResultados       FichaResultados[]
  reuniones              Reunion[]
  informes               Informe[]
  eventos                Evento[]
  seguimientosNormativos SeguimientoNormativo[]
  otrosEspacios          OtroEspacioArticulacion[]

  reportesEditados       ReporteCualitativo[]  @relation("EditorReporte")
  historialChat          HistorialChat[]

  // Ficha Resultados - Tracking por sección
  fichasEjecucionAct     FichaResultados[] @relation("EjecucionAct")
  fichasObrasAct         FichaResultados[] @relation("ObrasAct")
  fichasComitesAct       FichaResultados[] @relation("ComitesAct")
  fichasResiduosAct      FichaResultados[] @relation("ResiduosAct")
  fichasVentaAct         FichaResultados[] @relation("VentaAct")
  fichasConvivenciaAct   FichaResultados[] @relation("ConvivenciaAct")
  fichasActuacionesAct   FichaResultados[] @relation("ActuacionesAct")
  fichasEstrategiasAct   FichaResultados[] @relation("EstrategiasAct")
  fichasRollosAct        FichaResultados[] @relation("RollosAct")
}

model Plan {
  id            String     @id @default(uuid())
  nombre        String
  ano           Int
  descripcion   String?
  estado        EstadoPlan @default(BORRADOR)
  fechaCreacion DateTime   @default(now())
  creadoPor     String

  objetivos ObjetivoEstrategico[]
}

model ObjetivoEstrategico {
  id          String  @id @default(uuid())
  planId      String
  codigo      String // ej: "O1"
  nombre      String
  descripcion String?
  orden       Int

  plan                 Plan                 @relation(fields: [planId], references: [id])
  programas            Programa[]
  reportesCualitativos ReporteCualitativo[]
  fichasAlertas        FichaAlerta[]
}

model Programa {
  id          String  @id @default(uuid())
  objetivoId  String
  codigo      String // ej: "P03"
  nombre      String
  descripcion String?

  objetivo ObjetivoEstrategico @relation(fields: [objetivoId], references: [id])
  hitos    Hito[]
}

model Hito {
  id          String   @id @default(uuid())
  programaId  String
  codigo      String // ej: "H2"
  nombre      String
  descripcion String?
  fechaLimite DateTime

  programa    Programa    @relation(fields: [programaId], references: [id])
  actividades Actividad[]
}

model Actividad {
  id                       String          @id @default(uuid())
  hitoId                   String
  codigoCompleto           String          @unique // ej: "P03.H2.A1"
  nombre                   String
  descripcion              String?
  fechaInicio              DateTime?
  fechaLimite              DateTime?
  prioridad                Prioridad       @default(MEDIA)
  tiposEvidenciaRequeridos String[] // Array de strings o JSON
  indicadorMeta            Float
  indicadorUnidad          String
  estado                   EstadoActividad @default(PENDIENTE)
  creadoPor                String
  fechaCreacion            DateTime        @default(now())
  ultimaModificacion       DateTime        @updatedAt

  hito         Hito                  @relation(fields: [hitoId], references: [id])
  asignaciones AsignacionLocalidad[]
  subTareas    SubTarea[]
  evidencias   Evidencia[]
  comentarios  Comentario[]
  alertas      Alerta[]
  FichaAlerta  FichaAlerta[]
  historialCambios HistorialCambios[]
}

model Localidad {
  id                     String  @id @default(uuid())
  nombre                 String
  codigoDANE             String?
  responsablePrincipalId String?
  colorHex               String?

  responsablePrincipal Usuario?              @relation(fields: [responsablePrincipalId], references: [id])
  asignaciones         AsignacionLocalidad[]
  evidencias           Evidencia[]
  comentarios          Comentario[]
  alertas              Alerta[]
  FichaAlerta          FichaAlerta[]
  historialCambios     HistorialCambios[]
}

model AsignacionLocalidad {
  id               String           @id @default(uuid())
  actividadId      String
  localidadId      String
  responsableId    String?
  fechaAsignacion  DateTime         @default(now())
  observaciones    String?
  estadoLocal      EstadoLocalidad  @default(NO_INICIADA)
  estadoValidacion EstadoValidacion @default(PENDIENTE_REVISION)
  porcentajeAvance Float            @default(0)

  actividad   Actividad @relation(fields: [actividadId], references: [id])
  localidad   Localidad @relation(fields: [localidadId], references: [id])
  responsable Usuario?  @relation(fields: [responsableId], references: [id])

  @@unique([actividadId, localidadId])
}

model SubTarea {
  id                 String  @id @default(uuid())
  actividadId        String
  descripcion        String
  completada         Boolean @default(false)
  ordenVisualizacion Int     @default(0)

  actividad Actividad @relation(fields: [actividadId], references: [id])
}

model Evidencia {
  id                 String    @id @default(uuid())
  actividadId        String
  localidadId        String
  subidoPorId        String
  tipoEvidencia      String // documento/foto/video/enlace/reporte
  nombreArchivo      String
  urlArchivo         String // Ruta local o S3
  descripcion        String?
  fechaSubida        DateTime  @default(now())
  comentarioAdjunto  String?
  verificadaPorAdmin Boolean   @default(false)
  fechaVerificacion  DateTime?

  // Nuevos campos de pre-chequeo inteligente
  prechequeoEstado   CalidadPrechequeo  @default(DUDOSO)
  prechequeoPuntaje  Float              @default(0.0)
  prechequeoFeedback String?            @db.Text
  fechaAnalisisIA    DateTime?

  actividad Actividad @relation(fields: [actividadId], references: [id])
  localidad Localidad @relation(fields: [localidadId], references: [id])
  subidoPor Usuario   @relation(fields: [subidoPorId], references: [id])
}

model Comentario {
  id            String   @id @default(uuid())
  actividadId   String
  localidadId   String
  autorId       String
  texto         String
  fechaCreacion DateTime @default(now())
  esAlerta      Boolean  @default(false)
  tipoAlerta    String?

  actividad Actividad @relation(fields: [actividadId], references: [id])
  localidad Localidad @relation(fields: [localidadId], references: [id])
  autor     Usuario   @relation(fields: [autorId], references: [id])
}

model Alerta {
  id              String      @id @default(uuid())
  actividadId     String
  localidadId     String
  tipo            TipoAlerta
  descripcion     String
  nivel           NivelAlerta
  activa          Boolean     @default(true)
  fechaCreacion   DateTime    @default(now())
  resueltaPorId   String?
  fechaResolucion DateTime?

  actividad   Actividad @relation(fields: [actividadId], references: [id])
  localidad   Localidad @relation(fields: [localidadId], references: [id])
  resueltaPor Usuario?  @relation("ResueltaPor", fields: [resueltaPorId], references: [id])
}

model CorteMensual {
  id          String               @id @default(uuid())
  nombre      String
  fechaLimite DateTime
  esActivo    Boolean              @default(false)
  reportes    ReporteCualitativo[]
}

model ReporteCualitativo {
  id                          String              @id @default(uuid())
  objetivoId                  String
  corteId                     String
  // Textos Publicados (Consumidos por el Tablero de Control Ejecutivo)
  principalesAvances          String?             @db.Text
  alertasRecomendaciones      String?             @db.Text
  
  // Textos Borrador Generados por IA / Editados por el Administrador
  principalesAvancesDraft     String?             @db.Text
  alertasRecomendacionesDraft String?             @db.Text
  
  // Metadatos de Trazabilidad e IA
  estadoRevisionAvances       EstadoRevisionDraft @default(SIN_BORRADOR)
  estadoRevisionAlertas       EstadoRevisionDraft @default(SIN_BORRADOR)
  generadoPorIA               Boolean             @default(false)
  fechaGeneracionIA           DateTime?
  editadoPorId                String?             // Administrador de la Unidad de Transformación que revisa
  fechaUltimaEdicion          DateTime?

  objetivo                    ObjetivoEstrategico @relation(fields: [objetivoId], references: [id])
  corte                       CorteMensual        @relation(fields: [corteId], references: [id])
  editor                      Usuario?            @relation("EditorReporte", fields: [editadoPorId], references: [id])

  @@unique([objetivoId, corteId])
}

model FichaAlerta {
  id              String    @id @default(uuid())
  objetivoId      String?
  actividadId     String?
  localidadId     String?
  tipo            String // BLOQUEO_GESTION, BLOQUEO_GABINETE, BLOQUEO_ALTO_NIVEL, ESTRUCTURAL
  descripcion     String
  responsable     String
  fechaCompromiso DateTime?
  estado          String    @default("ABIERTA") // ABIERTA, RESUELTA
  ultimaAccion    String?   @db.Text
  creadoPorId     String
  fechaCreacion   DateTime  @default(now())
  correosResponsables String[]

  // Nuevos campos para enrutamiento e inteligencia de alertas
  sugerenciaSeveridad     NivelAlerta?
  confianzaClasificacion  Float?
  alertasRelacionadas     Json?
  procesadoPorIA          Boolean               @default(false)

  objetivo  ObjetivoEstrategico? @relation(fields: [objetivoId], references: [id])
  actividad Actividad?           @relation(fields: [actividadId], references: [id])
  localidad Localidad?           @relation(fields: [localidadId], references: [id])
  creador   Usuario              @relation(fields: [creadoPorId], references: [id])
  actualizaciones ActualizacionAlerta[]
}

model ActualizacionAlerta {
  id              String      @id @default(uuid())
  fichaAlertaId   String
  autorEmail      String
  autorNombre     String?
  comentario      String      @db.Text
  urlArchivo      String?
  fechaCreacion   DateTime    @default(now())

  fichaAlerta     FichaAlerta @relation(fields: [fichaAlertaId], references: [id], onDelete: Cascade)
}

// ─── MÓDULO GESTIÓN Y RESULTADOS ─────────────────────────────────────────────

model FichaResultados {
  id                       String   @id @default(uuid())
  periodo                  DateTime @unique // fecha de corte del reporte
  // Ejecución presupuestal
  compromisosPct           Float?
  metaCompromisosPct       Float?
  girosPct                 Float?
  metaGirosPct             Float?
  procesosMonitoreados     Int?
  procesosRequierenComite  Int?
  alertaEjecucion          String?  @db.Text
  // Obras locales
  metaObras                Int?
  intervencionesFinalizadas Int?
  kmCarrilIntervenido      Float?
  kmIntervenidos           Float?
  alertaObras              String?  @db.Text
  // Comités de contratación
  comitesRealizados        Int?
  comitesMeta              Int?
  alertaComites            String?  @db.Text
  // Espacio público – Residuos (general)
  accionesReportadas       Int?
  residuosM3               Float?
  espacioPublicoM2         Float?
  // Espacio público – Venta Informal / Parqueo
  puntosIntervenidos       Int?
  ventaInformal            Int?
  orgParqueo               Int?
  m2RecuperadosInformal    Float?
  personasReubicadas       Int?
  // Convivencia y seguridad
  motosContratadas         Int?
  motosPendientesFdl       Int?
  motosAlmacenFdl          Int?
  motosEntregadas          Int?
    motosEntregadasPolicia   Int?
  alertaConvivencia        String?  @db.Text
  // Actuaciones
  archivosPct              Float?
  metaArchivosPct          Float?
  metaArchivos             Int?
  fallosPrimeraEstanciaPct Float?
  metaFallosPct            Float?
  metaFallos               Int?
  // Estrategias de memoria
  estrategiasResueltas     Int?
  estrategiasFormulacion   Int?
  // Rollos legendarios
  rollosResueltos          Int?
  rollosEnCurso            Int?
  alertaRollos             String?  @db.Text
  // General
  observaciones            String?  @db.Text
  reportadoPorId           String
  fechaCreacion            DateTime @default(now())

  // Alertas faltantes
  alertaEspacioResiduos    String?  @db.Text
  alertaEspacioVenta       String?  @db.Text
  alertaActuaciones        String?  @db.Text
  alertaEstrategias        String?  @db.Text

  // Tracking por sección
  
    // --- Nuevos Campos para Rediseño Fichas (2026) ---
    avancesEjecucion          String?  @db.Text
    avancesObras              String?  @db.Text
    avancesRollos             String?  @db.Text
    avancesResiduos           String?  @db.Text
    avancesVenta              String?  @db.Text
    avancesActuaciones        String?  @db.Text
    avancesConvivencia        String?  @db.Text
    avancesEstrategias        String?  @db.Text
    
    obrasProgramadasAlCorte   Int?
    
    totalRollos               Int?
    rollosAvancesSignificativos Int?
    rollosProgramadosAlCorte  Int?
    
    puntosCriticosPriorizados Int?
    puntosSostenidos          Int?
    puntosSostenidosProgramados Int?
    personasSensibilizadas    Int?
    personasSensibilizadasProgramadas Int?
    operativosIVC             Int?
    operativosIVCProgramados  Int?
    
    puntosVerificados         Int?
    puntosProgramadosSostenibilidad Int?
    puntosSostenibilidadEfectiva Int?
    
    archivosProgramadosCorte  Float?
    fallosProgramadosCorte    Float?
    
    motosMetaTotal            Int?
    motosProgramadasCorte     Int?
    
    estrategiasTotal          Int?
    estrategiasAjustes        Int?
    estrategiasValidacionTecnica Int?
    estrategiasProgramadasCorte Int?
    // -------------------------------------------------

    ejecucionActPorId         String?
  ejecucionActEn            DateTime?
  obrasActPorId             String?
  obrasActEn                DateTime?
  comitesActPorId           String?
  comitesActEn              DateTime?
  espacioResiduosActPorId   String?
  espacioResiduosActEn      DateTime?
  espacioVentaActPorId      String?
  espacioVentaActEn         DateTime?
  convivenciaActPorId       String?
  convivenciaActEn          DateTime?
  actuacionesActPorId       String?
  actuacionesActEn          DateTime?
  estrategiasActPorId       String?
  estrategiasActEn          DateTime?
  rollosActPorId            String?
  rollosActEn               DateTime?

  reportadoPor          Usuario @relation(fields: [reportadoPorId], references: [id])
  ejecucionActPor       Usuario? @relation("EjecucionAct", fields: [ejecucionActPorId], references: [id])
  obrasActPor           Usuario? @relation("ObrasAct", fields: [obrasActPorId], references: [id])
  comitesActPor         Usuario? @relation("ComitesAct", fields: [comitesActPorId], references: [id])
  espacioResiduosActPor Usuario? @relation("ResiduosAct", fields: [espacioResiduosActPorId], references: [id])
  espacioVentaActPor    Usuario? @relation("VentaAct", fields: [espacioVentaActPorId], references: [id])
  convivenciaActPor     Usuario? @relation("ConvivenciaAct", fields: [convivenciaActPorId], references: [id])
  actuacionesActPor     Usuario? @relation("ActuacionesAct", fields: [actuacionesActPorId], references: [id])
  estrategiasActPor     Usuario? @relation("EstrategiasAct", fields: [estrategiasActPorId], references: [id])
  rollosActPor          Usuario? @relation("RollosAct", fields: [rollosActPorId], references: [id])
}

model Reunion {
  id               String   @id @default(uuid())
  // SESION_UNIDAD | REUNION_SEGUIMIENTO_AL | STOCKTAKE | VISITA_LOCALIDAD | MESA_TRABAJO | OTRA
  tipoReunion      String
  // ALCALDIA | SECTOR_GOBIERNO | ENTIDAD_DISTRITO | INTERNA | OTRA_ENTIDAD
  tipoContraparte  String
  // GLOBAL | P01..P10 | OTRO
  tematica         String   @default("GLOBAL")
  subtematica      String?
  objeto           String
  fecha            DateTime
  horaInicio       String
  horaFin          String
  lugar            String
  // PRESENCIAL | VIRTUAL | TELEFONICA | MIXTA
  modalidad        String
  responsable      String
  desarrollo       String?  @db.Text
  imagenAsistencia String?  // URL en Supabase Storage
  actaPdfUrl       String?  // URL de acta PDF pre-elaborada cargada por el usuario
  creadoPorId      String
  fechaCreacion    DateTime @default(now())

  creadoPor   Usuario            @relation(fields: [creadoPorId], references: [id])
  asistentes  AsistenteReunion[]
  compromisos CompromisoReunion[]
}

model AsistenteReunion {
  id        String  @id @default(uuid())
  reunionId String
  nombre    String
  cargo     String?
  entidad   String?

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
}

model CompromisoReunion {
  id           String    @id @default(uuid())
  reunionId    String
  descripcion  String
  responsable  String
  fechaEntrega DateTime?
  cumplido     Boolean   @default(false)

  reunion Reunion @relation(fields: [reunionId], references: [id], onDelete: Cascade)
}

model Informe {
  id            String   @id @default(uuid())
  // BOLETIN_TRANSFORMACION | REPORTE_SDG | INFORME_OAP | OTRO
  tipo          String
  titulo        String
  periodo       String
  descripcion   String?  @db.Text
  urlArchivo    String?
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}

model Evento {
  id            String   @id @default(uuid())
  // CONECTAR_TRANSFORMAR | OTRO
  tipo          String
  nombre        String
  fecha         DateTime
  lugar         String
  descripcion   String?  @db.Text
  resultados    String?  @db.Text
  urlArchivo    String?
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}

model SeguimientoNormativo {
  id            String   @id @default(uuid())
  // DECRETO | PROYECTO_LEY | OTRO
  tipo          String
  nombre        String
  descripcion   String?  @db.Text
  // EN_FORMULACION | EXPEDIDO | EN_IMPLEMENTACION | ARCHIVADO
  estado        String   @default("EN_FORMULACION")
  avances       String?  @db.Text
  urlDocumento  String?
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}

model OtroEspacioArticulacion {
  id            String   @id @default(uuid())
  // CIRCULO_CALIDAD | COMITE_OBRAS | COMITE_ESPACIO_PUBLICO | COMITE_RESIDUOS | COMITE_ACTUACIONES | OTRO
  tipo          String
  nombre        String
  fecha         DateTime
  descripcion   String?  @db.Text
  resultados    String?  @db.Text
  creadoPorId   String
  fechaCreacion DateTime @default(now())

  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])
}

// ─── NUEVOS MODELOS PARA IA Y MIGRACIÓN ──────────────────────────────────────

model HistorialChat {
  id            String   @id @default(uuid())
  usuarioId     String
  consulta      String   @db.Text
  respuesta     String   @db.Text
  exitoSQL      Boolean  @default(true)
  sentenciaSQL  String?  @db.Text
  feedbackUtiles Int?    // Calificación de utilidad
  fechaConsulta DateTime @default(now())

  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
}

model MigracionPlannERLog {
  id                   String   @id @default(uuid())
  fechaMigracion       DateTime @default(now())
  registrosProcesados  Int
  registrosExitosos    Int
  registrosFallidos    Int
  detallesErrores      Json?    // Errores en la validación lógica
  ejecutadoPor         String
}

model HistorialCambios {
  id                 String   @id @default(uuid())
  actividadId        String
  localidadId        String
  campoModificado    String   // ej: "estadoValidacion", "porcentajeAvance", "fechaLimite"
  valorAnterior      String?
  valorNuevo         String
  justificacion      String?  @db.Text // Razón del cambio (motivo de rechazo, etc.)
  usuarioResponsable String   // Correo o nombre del autor del cambio
  fechaCambio        DateTime
  origen             String   @default("SITRA") // "SITRA", "PLANNER_IMPORT_DEDUCIDO", "PLANNER_IMPORT_LIGERO"

  actividad          Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  localidad          Localidad @relation(fields: [localidadId], references: [id], onDelete: Cascade)
}


// ─── TABLERO OBRAS LOCALES ───────────────────────────────────────────────────

model FrenteObra {
  id                        Int       @id @default(autoincrement())
  localidad                 String?
  contrato                  String?
  tipo_intervencion         String?
  estado                    String?
  porcentaje_avance         Float?
  crono_inicio              DateTime?
  crono_fin                 DateTime?
  fecha_real_fin            DateTime?
  valor_final               Float?
  km_carril                 Float?
  m2                        Float?
  ml                        Float?
  huecos                    Float?
  tipo_contrato             String?
  categoria_inversion       String?
  justificacion_suspension  String?   @db.Text
  fecha_suspension          DateTime?
  fecha_corte               String?
}

model AlertaObra {
  id                        Int       @id @default(autoincrement())
  localidad                 String?
  contrato                  String?
  estado_general            String?   @db.Text
  acogio_tecnica            String?   @db.Text
  acogio_juridica           String?   @db.Text
  gestiones_otras_entidades String?   @db.Text
  observacion_tecnica       String?   @db.Text
  observacion_juridica      String?   @db.Text
  fecha_corte               String?
}

model MetadatoObra {
  id          Int      @id @default(autoincrement())
  fecha_corte String?
}
